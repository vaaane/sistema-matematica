{
  "rules": {

    "resultados": {
      ".read": true,
      ".write": true,
      ".indexOn": ["aluno", "turma", "atividade"],
      "$id": {
        ".validate": "newData.hasChildren(['aluno', 'atividade', 'turma'])"
      }
    },
    "detalhes": { ".read": true, ".write": true },

    "tabuada_niveis":          { ".read": true, ".write": true },
    "tabuada_ranking":         { ".read": true, ".write": true },
    "tabuada_sessoes":         { ".read": true, ".write": true },
    "tabuada_config":          { ".read": true, ".write": true },
    "tabuada_presenca":        { ".read": true, ".write": true },
    "tabuada_conquistas":      { ".read": true, ".write": true },
    "professor_tabuada_niveis":{ ".read": true, ".write": true },
    "professor_tabuada_config":{ ".read": true, ".write": true },
    "diplomas_impressos":      { ".read": true, ".write": true },
    "tabuada_negativos_niveis":{ ".read": true, ".write": true },
    "prof_neg_niveis":         { ".read": true, ".write": true },
    "prof_neg_notas":          { ".read": true, ".write": true },
    "tabuada_niveis_b":            { ".read": true, ".write": true },
    "tabuada_ranking_b":           { ".read": true, ".write": true },
    "tabuada_sprint_ranking_b":    { ".read": true, ".write": true },
    "tabuada_negativos_niveis_b":  { ".read": true, ".write": true },

    "escalada_niveis":             { ".read": true, ".write": true },
    "escalada_ranking":            { ".read": true, ".write": true },
    "escalada_niveis_b":           { ".read": true, ".write": true },
    "escalada_ranking_b":          { ".read": true, ".write": true },
    "jogo_revisao":                { ".read": true, ".write": true },
    "jogo_revisao_config":         { ".read": true, ".write": true },
    "jogo_revisao_turmas":         { ".read": true, ".write": true },
    "jogo_revisao_online":         { ".read": true, ".write": true, ".indexOn": ["mapa"] },
    "jogo_revisao_online_teste":   { ".read": true, ".write": true, ".indexOn": ["mapa"] },
    "jogo_revisao_pesca":          { ".read": true, ".write": true },
    "jogo_revisao_pesca_teste":    { ".read": true, ".write": true },
    "jogo_revisao_amigos":         { ".read": true, "$uid": { "$amigo": { ".write": true, ".validate": "newData.val() === true" } } },
    "jogo_revisao_amigos_teste":   { ".read": true, "$uid": { "$amigo": { ".write": true, ".validate": "newData.val() === true" } } },
    "jogo_revisao_equipes": { ".read": true, "$id": { ".write": true,
      ".validate": "newData.hasChildren(['nome', 'emblema', 'cor', 'dono', 'membros', 'criada'])",
      "nome": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
      "nome_pedido": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
      "nome_recusado": { ".validate": "newData.val() === true" },
      "emblema": { ".validate": "newData.isString() && newData.val().matches(/^(escudo|estrela|raio|coroa|chama|dragao|leao|lua|diamante|foguete|alvo|espiral)$/)" },
      "cor": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)" },
      "dono": { ".validate": "newData.isString() && (newData.parent().child('membros').child('1').val() === newData.val() || newData.parent().child('membros').child('2').val() === newData.val() || newData.parent().child('membros').child('3').val() === newData.val())" },
      "membros": { "$vaga": { ".validate": "$vaga.matches(/^[123]$/) && newData.isString() && ($vaga === '1' || newData.parent().child('1').val() !== newData.val()) && ($vaga === '2' || newData.parent().child('2').val() !== newData.val()) && ($vaga === '3' || newData.parent().child('3').val() !== newData.val()) && (data.val() === newData.val() || newData.parent().parent().child('dono').val() === newData.val() || root.child('jogo_revisao_convites_equipe').child(newData.val()).child($id).exists())" } },
      "entrou": { "$uid": { ".validate": "newData.isNumber()" } },
      "convidados": { "$uid": { ".validate": "newData.isNumber()" } },
      "criada": { ".validate": "newData.isNumber()" },
      "$outro": { ".validate": false } } },
    "jogo_revisao_equipes_contador": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" },
    "jogo_revisao_alunos": { ".read": true, "$uid": {
      "equipe": { ".write": true, ".validate": "newData.isString() && (newData.parent().parent().parent().child('jogo_revisao_equipes').child(newData.val()).child('membros').child('1').val() === $uid || newData.parent().parent().parent().child('jogo_revisao_equipes').child(newData.val()).child('membros').child('2').val() === $uid || newData.parent().parent().parent().child('jogo_revisao_equipes').child(newData.val()).child('membros').child('3').val() === $uid)" },
      "$outro": { ".validate": false } } },
    "jogo_revisao_convites_equipe": { ".read": true, "$destino": { "$id": { ".write": true, ".validate": "newData.hasChildren(['nome', 'emblema', 'cor', 'data'])" } } },
    "jogo_revisao_equipes_teste": { ".read": true, "$id": { ".write": true,
      ".validate": "newData.hasChildren(['nome', 'emblema', 'cor', 'dono', 'membros', 'criada'])",
      "nome": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
      "nome_pedido": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
      "nome_recusado": { ".validate": "newData.val() === true" },
      "emblema": { ".validate": "newData.isString() && newData.val().matches(/^(escudo|estrela|raio|coroa|chama|dragao|leao|lua|diamante|foguete|alvo|espiral)$/)" },
      "cor": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)" },
      "dono": { ".validate": "newData.isString() && (newData.parent().child('membros').child('1').val() === newData.val() || newData.parent().child('membros').child('2').val() === newData.val() || newData.parent().child('membros').child('3').val() === newData.val())" },
      "membros": { "$vaga": { ".validate": "$vaga.matches(/^[123]$/) && newData.isString() && ($vaga === '1' || newData.parent().child('1').val() !== newData.val()) && ($vaga === '2' || newData.parent().child('2').val() !== newData.val()) && ($vaga === '3' || newData.parent().child('3').val() !== newData.val()) && (data.val() === newData.val() || newData.parent().parent().child('dono').val() === newData.val() || root.child('jogo_revisao_convites_equipe_teste').child(newData.val()).child($id).exists())" } },
      "entrou": { "$uid": { ".validate": "newData.isNumber()" } },
      "convidados": { "$uid": { ".validate": "newData.isNumber()" } },
      "criada": { ".validate": "newData.isNumber()" },
      "$outro": { ".validate": false } } },
    "jogo_revisao_equipes_contador_teste": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" },
    "jogo_revisao_alunos_teste": { ".read": true, "$uid": {
      "equipe": { ".write": true, ".validate": "newData.isString() && (newData.parent().parent().parent().child('jogo_revisao_equipes_teste').child(newData.val()).child('membros').child('1').val() === $uid || newData.parent().parent().parent().child('jogo_revisao_equipes_teste').child(newData.val()).child('membros').child('2').val() === $uid || newData.parent().parent().parent().child('jogo_revisao_equipes_teste').child(newData.val()).child('membros').child('3').val() === $uid)" },
      "$outro": { ".validate": false } } },
    "jogo_revisao_convites_equipe_teste": { ".read": true, "$destino": { "$id": { ".write": true, ".validate": "newData.hasChildren(['nome', 'emblema', 'cor', 'data'])" } } },
    "jogo_revisao_nomes_pets": { ".read": true, "$k": { ".write": true, ".validate": "newData.hasChildren(['uid', 'pet', 'nome', 'data']) && newData.child('nome').isString() && newData.child('nome').val().length >= 2 && newData.child('nome').val().length <= 12" } },
    "jogo_revisao_nomes_pets_teste": { ".read": true, "$k": { ".write": true, ".validate": "newData.hasChildren(['uid', 'pet', 'nome', 'data']) && newData.child('nome').isString() && newData.child('nome').val().length >= 2 && newData.child('nome').val().length <= 12" } },
    "jogo_revisao_pedidos_amizade":       { ".read": true, "$destino": { "$origem": { ".write": "$origem !== $destino", ".validate": "newData.hasChildren(['nome', 'data'])" } } },
    "jogo_revisao_pedidos_amizade_teste": { ".read": true, "$destino": { "$origem": { ".write": "$origem !== $destino", ".validate": "newData.hasChildren(['nome', 'data'])" } } },
    "jogo_revisao_casinha_fotos":       { ".read": true, "$id": { ".write": true, ".validate": "newData.hasChildren(['uid', 'status']) && (newData.child('status').val() === 'pendente' || newData.child('status').val() === 'aprovado' || newData.child('status').val() === 'recusado')" } },
    "jogo_revisao_casinha_fotos_teste": { ".read": true, "$id": { ".write": true, ".validate": "newData.hasChildren(['uid', 'status']) && (newData.child('status').val() === 'pendente' || newData.child('status').val() === 'aprovado' || newData.child('status').val() === 'recusado')" } },
    "jogo_revisao_presentes":      { ".read": true, ".write": true },
    "jogo_revisao_presentes_teste":{ ".read": true, ".write": true },
    "jogo_revisao_praca":          { ".read": true, ".write": true, "casinhas": { "$uid": { "visitas": { ".validate": "newData.val() === 'amigos' || newData.val() === 'todos'" } } } },
    "jogo_revisao_praca_teste":    { ".read": true, ".write": true, "casinhas": { "$uid": { "visitas": { ".validate": "newData.val() === 'amigos' || newData.val() === 'todos'" } } } },
    "jogo_revisao_torre":          { ".read": true, ".write": true },
    "jogo_revisao_torre_teste":    { ".read": true, ".write": true },
    "jogo_revisao_aovivo":         { ".read": true, ".write": true },
    "jogo_revisao_aovivo_teste":   { ".read": true, ".write": true },
    "exposicao_config":            { ".read": true, ".write": "auth != null", "visitas_abertas": { ".validate": "newData.isBoolean()" }, "migracao_status": { ".validate": "newData.isBoolean()" },
      "ordem_salas": { "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 13" } },
      "modo": { ".validate": "newData.isString() && (newData.val() === 'montagem' || newData.val() === 'aberto' || newData.val() === 'encerrado')" },
      "resultado_visivel": { ".validate": "newData.isBoolean()" },
      "podio": { "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 13" } } },
    "exposicao_config_teste":      { ".read": true, ".write": "auth != null", "visitas_abertas": { ".validate": "newData.isBoolean()" }, "migracao_status": { ".validate": "newData.isBoolean()" },
      "ordem_salas": { "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 13" } },
      "modo": { ".validate": "newData.isString() && (newData.val() === 'montagem' || newData.val() === 'aberto' || newData.val() === 'encerrado')" },
      "resultado_visivel": { ".validate": "newData.isBoolean()" },
      "podio": { "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 13" } } },

    "exposicao_votos": { ".read": "auth != null", ".write": "auth != null",
      "$id": { ".read": true, ".write": "newData.exists() && $id.length <= 40 && root.child('exposicao_config').child('modo').val() === 'aberto'",
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 13" } },
    "exposicao_visitas": { ".read": true, ".write": "auth != null",
      "geral": { "$id": { ".write": "!data.exists() && newData.exists() && $id.length <= 40 && root.child('exposicao_config').child('modo').val() === 'aberto'", ".validate": "newData.isNumber()" } },
      "salas": { "$n": { "$id": { ".write": "!data.exists() && newData.exists() && $id.length <= 40 && $n.matches(/^([1-9]|1[0-3])$/) && root.child('exposicao_config').child('modo').val() === 'aberto'", ".validate": "newData.isNumber()" } } },
      "total": { ".write": "newData.exists() && root.child('exposicao_config').child('modo').val() === 'aberto'", ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" } },
    "exposicao_livro": { ".read": true, ".write": "auth != null",
      "reacoes": { "$id": { ".write": "newData.exists() && $id.length <= 40", ".validate": "newData.isString() && (newData.val() === '❤️' || newData.val() === '👏' || newData.val() === '✊🏾' || newData.val() === '🌟')" } },
      "recados": { "$id": { ".write": "(!data.exists() && newData.exists() && $id.length <= 40) || auth != null",
        ".validate": "newData.hasChildren(['texto', 'nome', 'ts'])",
        "texto": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
        "nome": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "ts": { ".validate": "newData.isNumber()" },
        "ok": { ".validate": "newData.isBoolean() && auth != null" },
        "$other": { ".validate": false } } } },
    "exposicao_votos_teste": { ".read": "auth != null", ".write": "auth != null",
      "$id": { ".read": true, ".write": "newData.exists() && $id.length <= 40 && root.child('exposicao_config_teste').child('modo').val() === 'aberto'",
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 13" } },
    "exposicao_visitas_teste": { ".read": true, ".write": "auth != null",
      "geral": { "$id": { ".write": "!data.exists() && newData.exists() && $id.length <= 40 && root.child('exposicao_config_teste').child('modo').val() === 'aberto'", ".validate": "newData.isNumber()" } },
      "salas": { "$n": { "$id": { ".write": "!data.exists() && newData.exists() && $id.length <= 40 && $n.matches(/^([1-9]|1[0-3])$/) && root.child('exposicao_config_teste').child('modo').val() === 'aberto'", ".validate": "newData.isNumber()" } } },
      "total": { ".write": "newData.exists() && root.child('exposicao_config_teste').child('modo').val() === 'aberto'", ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" } },
    "exposicao_livro_teste": { ".read": true, ".write": "auth != null",
      "reacoes": { "$id": { ".write": "newData.exists() && $id.length <= 40", ".validate": "newData.isString() && (newData.val() === '❤️' || newData.val() === '👏' || newData.val() === '✊🏾' || newData.val() === '🌟')" } },
      "recados": { "$id": { ".write": "(!data.exists() && newData.exists() && $id.length <= 40) || auth != null",
        ".validate": "newData.hasChildren(['texto', 'nome', 'ts'])",
        "texto": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
        "nome": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "ts": { ".validate": "newData.isNumber()" },
        "ok": { ".validate": "newData.isBoolean() && auth != null" },
        "$other": { ".validate": false } } } },
    "exposicao_salas":             { ".read": true, "$n": { ".write": "auth != null",
      "tema":     { ".write": true, ".validate": "newData.isString() && newData.val().length <= 40" },
      "musica":   { ".write": true, ".validate": "newData.isString() && newData.val().length <= 80" },
      "nome":     { ".validate": "newData.isString() && newData.val().length <= 60" },
      "nome_pendente": { ".validate": "newData.isString() && newData.val().length <= 60" },
      "nome_motivo":   { ".validate": "newData.isString() && newData.val().length <= 80" },
      "cores": { ".write": true, "parede": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" }, "chao": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" }, "$outro": { ".validate": false } },
      "itens": { ".write": true, "$id": {
        "status": { ".validate": "newData.isString() && (newData.val() === 'pendente' || newData.val() === 'aprovado' || newData.val() === 'recusado')" },
        "motivo": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "rev_ts": { ".validate": "newData.isNumber()" },
        "mv":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "x":      { ".validate": "newData.isNumber()" },
        "y":      { ".validate": "newData.isNumber()" },
        "tam":    { ".validate": "newData.isNumber() && newData.val() >= 0.6 && newData.val() <= 4" },
        "titulo": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "texto":  { ".validate": "newData.isString() && newData.val().length <= 400" } } } } },
    "exposicao_curtidas":          { ".read": true, "$n": { "$uid": { ".write": "$n.matches(/^[0-9]{1,2}$/) && $uid.length <= 80", ".validate": "newData.val() === true" } } },
    "exposicao_curtidas_teste":    { ".read": true, "$n": { "$uid": { ".write": "$n.matches(/^[0-9]{1,2}$/) && $uid.length <= 80", ".validate": "newData.val() === true" } } },
    "exposicao_desafio": { ".read": true, ".write": "auth != null",
      "$uid": { ".write": "auth != null || ($uid.length <= 40 && root.child('exposicao_config').child('modo').val() === 'aberto')", ".validate": "newData.hasChildren(['total', 'ts'])",
        "salas": { "$n": { ".validate": "$n.matches(/^([1-9]|1[0-3])$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 45" } },
        "jogos": { "$id": { ".validate": "$id.length <= 20 && newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" } },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 690" },
        "ts":    { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false } } },
    "exposicao_nomes": { ".read": true, ".write": "auth != null",
      "$uid": { ".write": "auth != null || ($uid.length <= 40 && root.child('exposicao_nomes_status').child($uid).val() !== 'aprovado')", ".validate": "newData.hasChildren(['nome', 'ts'])",
        "nome":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "turma": { ".validate": "newData.isString() && newData.val().length <= 6" },
        "ts":    { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false } } },
    "exposicao_nomes_status": { ".read": true, ".write": "auth != null", "$uid": { ".validate": "newData.val() === 'aprovado' || newData.val() === 'recusado'" } },
    "exposicao_completos": { ".read": true, ".write": "auth != null",
      "$uid": { ".write": "!data.exists() && newData.exists() && $uid.length <= 40 && root.child('exposicao_config').child('modo').val() === 'aberto'", ".validate": "newData.isNumber()" } },
    "exposicao_desafio_teste": { ".read": true, ".write": "auth != null",
      "$uid": { ".write": "auth != null || ($uid.length <= 40 && root.child('exposicao_config_teste').child('modo').val() === 'aberto')", ".validate": "newData.hasChildren(['total', 'ts'])",
        "salas": { "$n": { ".validate": "$n.matches(/^([1-9]|1[0-3])$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 45" } },
        "jogos": { "$id": { ".validate": "$id.length <= 20 && newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" } },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 690" },
        "ts":    { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false } } },
    "exposicao_nomes_teste": { ".read": true, ".write": "auth != null",
      "$uid": { ".write": "auth != null || ($uid.length <= 40 && root.child('exposicao_nomes_status_teste').child($uid).val() !== 'aprovado')", ".validate": "newData.hasChildren(['nome', 'ts'])",
        "nome":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "turma": { ".validate": "newData.isString() && newData.val().length <= 6" },
        "ts":    { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false } } },
    "exposicao_nomes_status_teste": { ".read": true, ".write": "auth != null", "$uid": { ".validate": "newData.val() === 'aprovado' || newData.val() === 'recusado'" } },
    "exposicao_completos_teste": { ".read": true, ".write": "auth != null",
      "$uid": { ".write": "!data.exists() && newData.exists() && $uid.length <= 40 && root.child('exposicao_config_teste').child('modo').val() === 'aberto'", ".validate": "newData.isNumber()" } },
    "exposicao_imagens":           { ".read": true, ".write": true, "$id": { "dados": { ".validate": "newData.isString() && newData.val().length <= 400000" } } },
    "exposicao_imagens_teste":     { ".read": true, ".write": true, "$id": { "dados": { ".validate": "newData.isString() && newData.val().length <= 400000" } } },
    "exposicao_salas_teste":       { ".read": true, "$n": { ".write": "auth != null",
      "tema":     { ".write": true, ".validate": "newData.isString() && newData.val().length <= 40" },
      "musica":   { ".write": true, ".validate": "newData.isString() && newData.val().length <= 80" },
      "nome":     { ".validate": "newData.isString() && newData.val().length <= 60" },
      "nome_pendente": { ".validate": "newData.isString() && newData.val().length <= 60" },
      "nome_motivo":   { ".validate": "newData.isString() && newData.val().length <= 80" },
      "cores": { ".write": true, "parede": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" }, "chao": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" }, "$outro": { ".validate": false } },
      "itens": { ".write": true, "$id": {
        "status": { ".validate": "newData.isString() && (newData.val() === 'pendente' || newData.val() === 'aprovado' || newData.val() === 'recusado')" },
        "motivo": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "rev_ts": { ".validate": "newData.isNumber()" },
